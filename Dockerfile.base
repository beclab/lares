# syntax=docker/dockerfile:1.7
# Environment image: OS toolchain, global CLIs, npm deps.
# Rebuild with `scripts/build-image.sh --base` when this file, package-lock, or CLI pins change.
FROM node:22-bookworm-slim

# build-essential + python3: community dsh plugins (e.g. dsh-better-sidebar →
# node-pty) have no linux prebuilds and compile via node-gyp at profile install
# time. The cluster forbids root pods, so the toolchain must live in the image
# and the boot-time `npm install` runs as uid 1000 with build scripts enabled.
# ffmpeg/ffprobe: on PATH for agent skills that process video (Debian package).
#
# The rest is what a coding agent reaches for and node:22-bookworm-slim does not
# have: inspection, archives, transfer, and in-cluster network diagnosis (the
# olares-doctor skill asks whether a service answers, from inside the pod).
# Debian's `yq` is the jq wrapper, not mikefarah's Go tool -- the filter syntax
# is jq's and YAML output needs -y.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl fd-find ffmpeg git jq ripgrep tini \
    build-essential python3 \
    file less procps tree \
    unzip zip xz-utils zstd \
    openssh-client patch rsync \
    dnsutils iproute2 iputils-ping netcat-openbsd socat \
    shellcheck yq \
  && ln -sf "$(command -v fdfind)" /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/*

# gh has no Debian package; upstream's apt repo is the only maintained route.
# The arch in the sources line comes from dpkg so both build legs resolve.
RUN install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/* \
  && gh --version

WORKDIR /app
ENV PORT=8080 \
  HOSTNAME=0.0.0.0 \
  HOME=/data/home \
  LARES_WORKSPACE=/data/workspace \
  LARES_DATA_DIR=/data/lares \
  LLM_GATEWAY_URL=http://router-svc.router-shared/v1 \
  OLARES_APP_ID=lares \
  LARES_CLI_ROOT=/data/cli

USER root
# The olares-* agent skills come out of this binary (app image runs
# `olares-cli skills export`), so a pin without the suite has to fail here
# rather than one layer later.
RUN npm install -g @olares/cli@1.12.7-cli.4 @olares/hass-cli@0.0.1 \
  && ln -sf "$(npm root -g)/@olares/cli/bin/olares-cli.js" /usr/local/bin/olares-cli \
  && ln -sf "$(npm root -g)/@olares/hass-cli/bin/hass-cli.js" /usr/local/bin/hass-cli \
  && olares-cli -v \
  && olares-cli skills list -q \
  && hass-cli -v

COPY package.json package-lock.json ./
# Keep devDependencies (tsc / esbuild) so the app image can compile without a second npm ci.
RUN npm ci --include=dev

ENV NODE_ENV=production

RUN mkdir -p /data/home /data/lares /data/workspace /data/cli \
  && chown -R node:node /data /app

USER node
VOLUME ["/data"]
EXPOSE 8080

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npm", "run", "start"]
