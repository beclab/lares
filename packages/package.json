{
  "name": "dina",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist-server/index.js",
    "start:watch": "node dist-server/dev-supervisor.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/**/*.test.ts",
    "dump-config": "tsx server/dsh-web/dump-config.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-web-app": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
