{
  "name": "lares",
  "title": "Lares",
  "image_repo": "docker.io/beclab/lares",
  "image_base_tag": "17",
  "npm_scope": "@lares",
  "hot_reload": {
    "source_subpath": "devsrc",
    "prebuild": "npm run build",
    "chown": "1000:1000",
    "excludes": [
      ".git/",
      ".cursor/",
      "node_modules/",
      "__pycache__/",
      "*.pyc",
      ".env",
      ".env.*",
      ".hotreload",
      "deploy/",
      "scripts/",
      "tests/",
      "artifacts/",
      "*.tgz",
      "*.md",
      ".lares-seeded-image-id",
      "packages/skills/olares-*/"
    ]
  }
}
