{
  "name": "lares",
  "title": "Lares",
  "image_repo": "docker.io/beclab/lares",
  "image_base_tag": "11",
  "npm_scope": "@lares",
  "hot_reload": {
    "source_subpath": "devsrc",
    "excludes": [
      ".git/",
      ".cursor/",
      "node_modules/",
      "__pycache__/",
      "*.pyc",
      ".env",
      ".env.*",
      "deploy/",
      "scripts/",
      "tests/",
      "artifacts/",
      "*.tgz",
      "*.md",
      ".lares-image-id"
    ]
  }
}
