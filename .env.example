PORT=8080
HOSTNAME=0.0.0.0
LLM_GATEWAY_URL=http://router-svc.router-shared/v1
OLARES_APP_ID=lares
# 仅本地调试：集群安装不暴露此项，走 x-caller-appid。
# LARES_ROUTER_API_KEY=
# 默认模型在「设置 → 模型」选择，无需环境变量。
# 语音输入的模型 / 语言 / 市场应用在「设置 → 语音输入」面板配置
# （持久化到 $DSH_HOME/voice-input/config.json），无需环境变量。
# 网络搜索提供方（Tavily / 自定义 URL+Key）在「设置 → 网络搜索」配置
# （持久化到 $DSH_HOME/web-search/config.json），无需环境变量。
LARES_WORKSPACE=/data/workspace
LARES_DATA_DIR=/data/lares
LARES_CLI_ROOT=/data/cli
# Optional: override dsh home (default $LARES_DATA_DIR/dsh-home)
# DSH_HOME=
# DEEPSEEK_API_KEY=lares-local
# Optional: override the LLM persona (default: packages/core/brand/identity.js)
# DSH_SYSTEM_PROMPT=
# DSH_PERMISSION_MODE=workspace-write
