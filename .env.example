PORT=8080
HOSTNAME=0.0.0.0
LLM_GATEWAY_URL=http://router-svc.router-shared/v1
OLARES_APP_ID=dina
DINA_ROUTER_API_KEY=
DINA_DEFAULT_MODEL=
# 语音输入的模型 / 语言 / 市场应用在「设置 → 语音输入」面板配置
# （持久化到 $DSH_HOME/voice-input/config.json），无需环境变量。
DINA_WORKSPACE=/data/workspace
DINA_DATA_DIR=/data/dina
DINA_CLI_ROOT=/data/cli
# Optional: override dsh home (default $DINA_DATA_DIR/dsh-home)
# DSH_HOME=
# DEEPSEEK_API_KEY=dina-local
# DSH_SYSTEM_PROMPT=You are Dina, a helpful assistant running on Olares.
# DSH_PERMISSION_MODE=workspace-write
