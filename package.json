{
  "name": "lares",
  "version": "0.15.8",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mobile"
  ],
  "scripts": {
    "predev": "npm run build:client && npm run build:mobile",
    "dev": "tsx watch packages/service/index.ts",
    "build": "npm run build:client && npm run build:mobile && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:mobile": "vite build --config packages/mobile/vite.config.js",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/service/launch.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "sh -c 'tsx --test tests/olares/*.test.ts tests/plugins/*.test.ts tests/skills/*.test.ts'",
    "test:e2e:cli": "node __debug__/e2e/olares-cli-machine1.mjs",
    "test:e2e:media": "node __debug__/e2e/media-generate-machine1.mjs",
    "test:e2e:browser": "OLARES_NO_DIALOG=1 node ~/.cursor/skills/olares-browser-login/scripts/session.mjs run __debug__/browser-scenarios/lares-regression.mjs --machine 1 --wait 5000 --insecure",
    "test:e2e:plugins": "OLARES_NO_DIALOG=1 node ~/.cursor/skills/olares-browser-login/scripts/session.mjs run __debug__/browser-scenarios/lares-plugin-matrix.mjs --machine 1 --wait 5000 --insecure",
    "dump-config": "tsx packages/service/dsh-web/dump-config.ts",
    "postinstall": "node scripts/apply-vendor-patches.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@nats-io/transport-node": "^3.4.0",
    "@olares/lares-core": "*",
    "@ricky0123/vad-web": "^0.0.31",
    "sentencex": "^1.0.32",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "three": "^0.181.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vue": "^3.5.43"
  }
}
